AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=https://s3.scalewithus.com
S3_BUCKET=linux-mirrors
S3_REGION=us-east-1
S3_ADDRESSING=path
# Optional: bucket capacity in bytes so /metrics can show S3 free space (quota - used)
# 10 TiB example:
S3_QUOTA_BYTES=10995116277760
# How often to re-list the bucket for usage stats (seconds)
# S3_USAGE_REFRESH_SECONDS=300
# Persisted /metrics counters (survive container restarts; needs mirror_data volume)
# METRICS_STATE_PATH=/var/lib/linux-mirror/metrics.json
# METRICS_FLUSH_SECONDS=10
LOG_LEVEL=INFO
METADATA_CACHE_SECONDS=21600
PACKAGE_CACHE_SECONDS=15552000
NEGATIVE_CACHE_SECONDS=60
MAX_SPOOL_BYTES=4294967296
MIN_TMP_FREE_BYTES=536870912
UPSTREAM_TIMEOUT=120
ACME_EMAIL=admin@scalewithus.com
