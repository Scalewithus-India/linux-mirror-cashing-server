{
	email {$ACME_EMAIL}
}

(mirror_proxy) {
	encode zstd gzip
	reverse_proxy mirror:8080 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		flush_interval -1
		transport http {
			read_timeout 0
			write_timeout 0
		}
	}
	header {
		-Server
	}
}

mirror.scalewithus.com {
	import mirror_proxy
}

# cPanel HTTPUPDATE= must hit host root (/cpanelsync, /RPM, …).
# Rewrite to the app's /cpanel/ prefix. Serve plain HTTP (no redirect) because
# cPanel upcp uses http://HTTPUPDATE/... on port 80.
http://httpupdate.scalewithus.com {
	rewrite * /cpanel{uri}
	import mirror_proxy
}

httpupdate.scalewithus.com {
	rewrite * /cpanel{uri}
	import mirror_proxy
}

# Hosts-file / private-DNS override: point httpupdate.cpanel.net → this IP.
# HTTP only — do not enable HTTPS here (we cannot obtain a cert for cpanel.net).
http://httpupdate.cpanel.net {
	rewrite * /cpanel{uri}
	import mirror_proxy
}
